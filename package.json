{
  "name": "simplefs",
  "version": "1.0.0",
  "description": "Minimalist, high-performance file server with HTMX, Tailwind CSS and Go",
  "scripts": {
    "build:css": "tailwindcss -i ./web/src/input.css -o ./web/static/style.css --minify",
    "dev:css": "tailwindcss -i ./web/src/input.css -o ./web/static/style.css --watch",
    "build:vendor": "esbuild ./web/src/vendor.js --bundle --minify --outfile=./web/static/vendor.js && esbuild ./web/src/vendor.css --bundle --minify --loader:.woff2=file --loader:.woff=file --loader:.ttf=file --outdir=./web/static",
    "build:go": "go build -o simplefs ./cmd/simplefs/main.go",
    "build": "pnpm run build:vendor && pnpm run build:css && pnpm run build:go",
    "start": "./simplefs"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "esbuild": "^0.28.2",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.12.0",
    "htmx.org": "^2.0.10",
    "marked": "^18.0.9",
    "material-symbols": "^0.46.0"
  }
}
