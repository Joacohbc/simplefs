# Copy to .env and adjust. Read by docker compose.

# Address the port is published on. Keep 127.0.0.1 for local use, or set the VPN IP
# of this machine (Tailscale 100.x.y.z, WireGuard 10.x.y.z...) to share it over the VPN.
BIND_IP=127.0.0.1
HOST_PORT=8080

# Host user that owns ./uploads (run `id -u` / `id -g`).
PUID=1000
PGID=1000

# Full-access token. Leave empty to auto-generate one (docker exec simplefs /simplefs token).
# Generate one with: openssl rand -hex 24
SIMPLEFS_TOKEN=
# Optional read-only token for clients that only download.
SIMPLEFS_READ_TOKEN=

# Host names used to reach the server besides IPs/localhost (comma separated),
# e.g. my-pc.tailnet-name.ts.net
ALLOWED_HOSTS=

# Maximum upload size (e.g. 2G). 0 = unlimited.
MAX_UPLOAD_SIZE=0
